# Copy to .env and adjust. docker compose reads .env automatically;
# for the Alpine/OpenRC install, put these in /etc/conf.d/dinner-log instead.
# Never commit your real .env.

# IANA time zone used for "today" (default day, catch-up, suggestions).
# Leave at UTC and evening dinners in the Americas default to tomorrow.
APP_TZ=UTC

# Base URL of a Cookbook Collection instance (optional). Enables cookbook
# title autocomplete and links into the catalog.
# COOKBOOK_URL=https://cookbooks.example.com

# Address this server uses to call Cookbook Collection (defaults to COOKBOOK_URL).
# Use its private address; its /admin API is behind the login on the public one.
# COOKBOOK_API_URL=http://127.0.0.1:8767

# Cookbook Collection's READ_TOKEN, for "Pick for tonight" (ingredients, try new).
# Treat it like a password.
# COOKBOOK_TOKEN=

# Lets Cookbook Collection read cooking history from /api/history (optional).
# Generate with `openssl rand -hex 32` and set the same value as Cookbook
# Collection's DINNERLOG_TOKEN. Unset: the endpoint doesn't exist.
# HISTORY_TOKEN=

# Extra origins allowed to POST, comma-separated. Only needed if your proxy
# rewrites the Host header (see README > Security).
# TRUSTED_ORIGINS=https://dinners.example.com

# Backups (backup.py; see README > Backups). Snapshots default to DATA_DIR/backups.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP_DAYS=14
# Folder on other storage (mounted into the container) that also gets snapshots and photos.
# BACKUP_TARGET=/backup-target

# Verify Cloudflare Access sign-ins in the app (optional; set both or neither).
# Every request then needs Access's token, except /api/history (bearer token) and /healthz.
# CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_AUD=

# With Access verification on, also let in direct requests from the local network (see README).
# Under Docker, check which client address the app sees first.
# LAN_ACCESS=0
# LAN_CIDRS=192.168.1.0/24
# LAN_HOSTS=dinners.lan
